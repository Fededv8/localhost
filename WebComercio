<!DOCTYPE html>
<html lang="es-AR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Talabartería El Moro | Artículos para caballos y campo</title>
<meta name="description" content="Talabartería El Moro — botas, mantas, monturas, recados, cojinillos y accesorios de cuero para el campo. Balbastro 3301, CABA.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rye&family=Fraunces:ital,wght@0,500;0,600;1,500&family=Karla:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --leather-dark:#241610;
    --leather-mid:#5c3a24;
    --leather-light:#8a5a35;
    --oxblood:#7a2e2a;
    --brass:#b8935e;
    --brass-bright:#d4ad78;
    --cream:#ede3d3;
    --cream-2:#e2d5bf;
    --ink:#241812;

    --font-display:'Rye', serif;
    --font-serif:'Fraunces', serif;
    --font-body:'Karla', sans-serif;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.01ms !important; transition-duration:0.01ms !important;}
  }

  body{
    margin:0;
    font-family:var(--font-body);
    color:var(--ink);
    background:var(--cream);
    line-height:1.5;
  }

  a{color:inherit;}
  img{max-width:100%; display:block;}

  a:focus-visible, button:focus-visible{
    outline:3px solid var(--brass-bright);
    outline-offset:3px;
  }

  .eyebrow{
    font-family:var(--font-body);
    font-weight:700;
    letter-spacing:.18em;
    text-transform:uppercase;
    font-size:.78rem;
    color:var(--brass);
  }

  .wrap{
    max-width:1100px;
    margin:0 auto;
    padding:0 24px;
  }

  /* ---------- Stitch divider (saddle-stitch seam) ---------- */
  .stitch{
    height:14px;
    background-image:
      repeating-linear-gradient(90deg, var(--brass) 0 10px, transparent 10px 20px),
      repeating-linear-gradient(90deg, var(--brass) 0 10px, transparent 10px 20px);
    background-position: 0 3px, 10px 9px;
    background-size: 20px 2px, 20px 2px;
    background-repeat:repeat-x;
    opacity:.55;
  }

  /* ---------- Header ---------- */
  header{
    position:sticky;
    top:0;
    z-index:50;
    background:var(--leather-dark);
    border-bottom:1px solid rgba(184,147,94,.35);
  }
  .nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:14px 0;
  }
  .brand{
    display:flex;
    align-items:center;
    gap:12px;
    text-decoration:none;
    color:var(--cream);
  }
  .brand-name{
    font-family:var(--font-display);
    font-size:1.3rem;
    letter-spacing:.03em;
    color:var(--cream);
  }
  .stamp{
    width:44px;
    height:44px;
    border-radius:50%;
    border:2px solid var(--brass);
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
    position:relative;
  }
  .stamp::before{
    content:'';
    position:absolute;
    inset:5px;
    border:1px solid var(--brass);
    border-radius:50%;
    opacity:.6;
  }
  .stamp span{
    font-family:var(--font-display);
    color:var(--brass-bright);
    font-size:1.1rem;
  }
  nav.links{
    display:flex;
    gap:28px;
    list-style:none;
    margin:0; padding:0;
  }
  nav.links a{
    text-decoration:none;
    color:var(--cream-2);
    font-weight:500;
    font-size:.95rem;
    letter-spacing:.02em;
    transition:color .15s;
  }
  nav.links a:hover{color:var(--brass-bright);}

  .menu-btn{
    display:none;
    background:none;
    border:1px solid var(--brass);
    color:var(--cream);
    padding:8px 10px;
    border-radius:4px;
    cursor:pointer;
  }

  @media (max-width:760px){
    nav.links{
      position:absolute;
      top:100%; left:0; right:0;
      background:var(--leather-dark);
      flex-direction:column;
      padding:18px 24px;
      gap:16px;
      border-bottom:1px solid rgba(184,147,94,.35);
      display:none;
    }
    nav.links.open{display:flex;}
    .menu-btn{display:block;}
    .nav-right{gap:12px;}
  }

  /* ---------- Carrito: header ---------- */
  .nav-right{
    display:flex;
    align-items:center;
    gap:18px;
  }
  .cart-btn{
    position:relative;
    background:none;
    border:1px solid var(--brass);
    color:var(--brass-bright);
    width:40px; height:40px;
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    cursor:pointer;
    flex-shrink:0;
    transition:background .15s;
  }
  .cart-btn:hover{background:rgba(184,147,94,.15);}
  .cart-icon{width:19px; height:19px;}
  .cart-badge{
    position:absolute;
    top:-6px; right:-6px;
    background:var(--oxblood);
    color:var(--cream);
    font-size:.68rem;
    font-weight:700;
    min-width:18px; height:18px;
    border-radius:9px;
    display:flex; align-items:center; justify-content:center;
    padding:0 4px;
    font-family:var(--font-body);
  }
  .cart-badge.bump{animation:cartBump .3s ease;}
  @keyframes cartBump{
    0%{transform:scale(1);}
    50%{transform:scale(1.4);}
    100%{transform:scale(1);}
  }

  /* ---------- Carrito: panel lateral ---------- */
  .cart-overlay{
    position:fixed; inset:0;
    background:rgba(20,12,8,.55);
    opacity:0;
    pointer-events:none;
    transition:opacity .25s ease;
    z-index:90;
  }
  .cart-overlay.abierto{opacity:1; pointer-events:auto;}

  .cart-panel{
    position:fixed;
    top:0; right:0;
    height:100%;
    width:min(420px, 100%);
    background:var(--leather-dark);
    color:var(--cream);
    border-left:1px solid rgba(184,147,94,.35);
    transform:translateX(100%);
    transition:transform .3s ease;
    z-index:95;
    display:flex;
    flex-direction:column;
  }
  .cart-panel.abierto{transform:translateX(0);}
  body.carrito-abierto{overflow:hidden;}

  .cart-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:20px 22px;
    border-bottom:1px solid rgba(184,147,94,.25);
    flex-shrink:0;
  }
  .cart-header h3{
    font-family:var(--font-serif);
    font-weight:600;
    font-size:1.2rem;
    margin:0;
    color:var(--cream);
  }
  .cart-close{
    background:none; border:none;
    color:var(--cream-2);
    font-size:1.7rem;
    line-height:1;
    cursor:pointer;
    padding:0 4px;
  }
  .cart-close:hover{color:var(--brass-bright);}

  .cart-items{
    flex:1;
    overflow-y:auto;
    padding:8px 22px;
  }
  .cart-empty{
    color:var(--cream-2);
    text-align:center;
    padding:48px 0;
    font-size:.95rem;
  }

  .cart-item{
    display:flex;
    gap:12px;
    padding:16px 0;
    border-bottom:1px solid rgba(184,147,94,.15);
    animation:cartItemIn .25s ease;
  }
  @keyframes cartItemIn{
    from{opacity:0; transform:translateY(-8px);}
    to{opacity:1; transform:translateY(0);}
  }
  .cart-item.saliendo{
    animation:cartItemOut .22s ease forwards;
  }
  @keyframes cartItemOut{
    to{opacity:0; transform:translateX(40px);}
  }

  .cart-item-img{
    width:64px; height:64px;
    object-fit:cover;
    border-radius:4px;
    background:var(--leather-mid);
    flex-shrink:0;
  }
  .cart-item-body{flex:1; min-width:0;}
  .cart-item-top{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:8px;
  }
  .cart-item-top h4{
    margin:0;
    font-family:var(--font-serif);
    font-weight:600;
    font-size:.96rem;
    color:var(--cream);
  }
  .cart-item-remove{
    background:none; border:none;
    color:var(--cream-2);
    font-size:1rem;
    cursor:pointer;
    padding:2px;
    flex-shrink:0;
  }
  .cart-item-remove:hover{color:var(--oxblood);}
  .cart-item-price{
    margin:2px 0 8px;
    font-size:.83rem;
    color:var(--cream-2);
  }
  .cart-item-controls{
    display:flex;
    align-items:center;
    gap:14px;
    margin-bottom:8px;
    flex-wrap:wrap;
  }
  .qty-control{
    display:flex;
    align-items:center;
    gap:10px;
    border:1px solid rgba(184,147,94,.35);
    border-radius:4px;
    padding:2px 10px;
  }
  .qty-control button{
    background:none; border:none;
    color:var(--brass-bright);
    font-size:1rem;
    cursor:pointer;
    width:18px;
    padding:2px 0;
  }
  .qty-control span{min-width:16px; text-align:center; font-size:.88rem;}
  .cart-item-edit{
    background:none; border:none;
    color:var(--brass);
    text-decoration:underline;
    font-size:.78rem;
    cursor:pointer;
    padding:0;
  }
  .cart-item-note{
    display:none;
    margin-bottom:8px;
  }
  .cart-item-note.abierta{display:block;}
  .cart-item-note input{
    width:100%;
    background:rgba(255,255,255,.05);
    border:1px solid rgba(184,147,94,.3);
    color:var(--cream);
    border-radius:4px;
    padding:6px 10px;
    font-size:.8rem;
    font-family:var(--font-body);
  }
  .cart-item-subtotal{
    margin:0;
    font-size:.85rem;
    font-weight:700;
    color:var(--brass-bright);
  }

  .cart-footer{
    padding:16px 22px 22px;
    border-top:1px solid rgba(184,147,94,.25);
    flex-shrink:0;
  }
  .cart-total-row{
    display:flex;
    justify-content:space-between;
    font-family:var(--font-serif);
    font-size:1.15rem;
    font-weight:600;
    margin-bottom:16px;
    color:var(--cream);
  }
  .cart-checkout{
    width:100%;
    justify-content:center;
    margin-bottom:10px;
  }
  .cart-checkout.disabled{
    opacity:.4;
    pointer-events:none;
  }
  .cart-clear{
    width:100%;
    background:none;
    border:1px solid rgba(184,147,94,.3);
    color:var(--cream-2);
    padding:10px;
    border-radius:3px;
    font-size:.82rem;
    cursor:pointer;
  }
  .cart-clear:hover{border-color:var(--oxblood); color:var(--oxblood);}

  /* Botón "agregar al carrito" chico en las cards de producto */
  .card.producto-card .producto-info{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:10px;
  }
  .add-cart-mini{
    background:none;
    border:1px solid var(--brass);
    color:var(--brass-bright);
    font-size:.72rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.04em;
    padding:7px 14px;
    border-radius:3px;
    cursor:pointer;
    font-family:var(--font-body);
    transition:background .15s;
  }
  .add-cart-mini:hover{background:rgba(184,147,94,.15);}
  .add-cart-mini.agregado{
    background:var(--oxblood);
    border-color:var(--oxblood);
    color:var(--cream);
  }

  .detalle-botones{
    display:flex;
    gap:12px;
    justify-content:center;
    flex-wrap:wrap;
  }

  /* ---------- Hero ---------- */
  .hero{
    background:
      radial-gradient(ellipse at 20% -10%, rgba(184,147,94,.18), transparent 55%),
      radial-gradient(ellipse at 85% 110%, rgba(122,46,42,.35), transparent 60%),
      var(--leather-dark);
    color:var(--cream);
    padding:96px 0 88px;
    text-align:center;
    position:relative;
    overflow:hidden;
  }
  .hero::after{
    content:'';
    position:absolute;
    inset:0;
    background-image:
      repeating-linear-gradient(115deg, rgba(255,255,255,.02) 0 2px, transparent 2px 6px);
    pointer-events:none;
  }
  .hero-stamp{
    width:96px; height:96px;
    border-radius:50%;
    border:3px solid var(--brass);
    display:flex; align-items:center; justify-content:center;
    margin:0 auto 28px;
    position:relative;
  }
  .hero-stamp::before{
    content:'';
    position:absolute; inset:9px;
    border:1px solid var(--brass);
    border-radius:50%;
    opacity:.6;
  }
  .hero-stamp span{
    font-family:var(--font-display);
    font-size:2rem;
    color:var(--brass-bright);
  }
  .hero h1{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:14px;
    font-family:var(--font-display);
    font-size:clamp(2.2rem, 6vw, 4rem);
    letter-spacing:.02em;
    margin:0 0 18px;
    color:var(--cream);
  }
  .flag-ar{
    display:inline-flex;
    flex-shrink:0;
  }
  .flag-ar svg{
    width:38px;
    height:auto;
    border-radius:2px;
    box-shadow:0 0 0 1px rgba(0,0,0,.25);
  }
  @media (max-width:520px){
    .flag-ar svg{width:26px;}
  }
  .hero p.tagline{
    font-family:var(--font-serif);
    font-style:italic;
    font-weight:500;
    font-size:clamp(1.05rem, 2.4vw, 1.35rem);
    color:var(--cream-2);
    max-width:560px;
    margin:0 auto 36px;
  }
  .cta-row{
    display:flex;
    gap:16px;
    justify-content:center;
    flex-wrap:wrap;
  }
  .btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:14px 28px;
    border-radius:3px;
    text-decoration:none;
    font-weight:700;
    font-size:.95rem;
    letter-spacing:.03em;
    text-transform:uppercase;
    transition:transform .15s, background .15s;
    border:2px solid transparent;
  }
  .btn:hover{transform:translateY(-2px);}
  .btn-primary{
    background:var(--oxblood);
    color:var(--cream);
    border-color:var(--oxblood);
  }
  .btn-primary:hover{background:#8f3833;}
  .btn-outline{
    border-color:var(--brass);
    color:var(--cream);
  }
  .btn-outline:hover{background:rgba(184,147,94,.15);}

  /* ---------- Section shell ---------- */
  section{padding:76px 0;}
  .section-head{
    text-align:center;
    max-width:640px;
    margin:0 auto 48px;
  }
  .section-head h2{
    font-family:var(--font-serif);
    font-weight:600;
    font-size:clamp(1.6rem, 4vw, 2.3rem);
    margin:10px 0 14px;
    color:var(--ink);
  }
  .section-head p{
    color:#4a3a2c;
    font-size:1.02rem;
  }

  /* ---------- Nosotros ---------- */
  .nosotros{background:var(--cream);}
  .nosotros-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:48px;
    align-items:center;
  }
  .nosotros-text p{
    color:#4a3a2c;
    font-size:1.05rem;
    margin-bottom:18px;
  }
  .nosotros-card{
    background:var(--leather-dark);
    color:var(--cream);
    border-radius:6px;
    padding:32px;
    border:1px solid rgba(184,147,94,.4);
  }
  .nosotros-card .stamp{margin-bottom:16px;}
  .nosotros-card h3{
    font-family:var(--font-serif);
    font-style:italic;
    font-weight:500;
    font-size:1.2rem;
    margin:0 0 10px;
    color:var(--brass-bright);
  }
  .nosotros-card p{
    color:var(--cream-2);
    font-size:.95rem;
    margin:0;
  }
  @media (max-width:760px){
    .nosotros-grid{grid-template-columns:1fr;}
  }

  /* ---------- Productos ---------- */
  .productos{
    background:var(--leather-mid);
    background-image:radial-gradient(ellipse at 50% 0%, rgba(184,147,94,.15), transparent 60%);
    color:var(--cream);
  }
  .productos .section-head p{color:var(--cream-2);}
  .grid{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:20px;
  }
  @media (max-width:900px){.grid{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:520px){.grid{grid-template-columns:1fr;}}

  .card{
    background:rgba(36,22,16,.55);
    border:1px solid rgba(184,147,94,.35);
    border-radius:6px;
    padding:26px 20px;
    text-align:center;
    transition:border-color .15s, transform .15s;
  }
  .card:hover{
    border-color:var(--brass-bright);
    transform:translateY(-3px);
  }
  .card svg{
    width:42px; height:42px;
    stroke:var(--brass-bright);
    fill:none;
    stroke-width:1.6;
    margin-bottom:14px;
  }
  .card h3{
    font-family:var(--font-serif);
    font-weight:600;
    font-size:1.05rem;
    margin:0 0 8px;
    color:var(--cream);
  }
  .card p{
    font-size:.85rem;
    color:var(--cream-2);
    margin:0;
  }

  /* ---------- Catálogo: navegación entre vistas ---------- */
  .vista-oculta{display:none;}

  .vista-header{
    display:flex;
    align-items:center;
    gap:20px;
    flex-wrap:wrap;
    margin-bottom:32px;
  }
  .btn-volver{
    padding:10px 18px;
    font-size:.82rem;
    cursor:pointer;
    background:none;
    font-family:var(--font-body);
  }
  .titulo-categoria{
    font-family:var(--font-serif);
    font-weight:600;
    font-size:1.4rem;
    color:var(--cream);
    margin:0;
  }

  /* Producto dentro de la grilla de una categoría */
  .card.producto-card{
    cursor:pointer;
    text-align:left;
    padding:0;
    overflow:hidden;
  }
  .card.producto-card .producto-img{
    width:100%;
    aspect-ratio:1/1;
    object-fit:cover;
    background:var(--leather-dark);
  }
  .card.producto-card .producto-info{
    padding:16px 18px 20px;
  }
  .card.producto-card h3{margin:0 0 6px;}
  .card.producto-card .precio{
    color:var(--brass-bright);
    font-weight:700;
    font-size:1rem;
    margin:0;
  }
  .card[data-categoria]{cursor:pointer;}

  /* Vista de detalle de producto */
  .detalle-card{
    max-width:460px;
    margin:0 auto;
    background:rgba(36,22,16,.55);
    border:1px solid rgba(184,147,94,.35);
    border-radius:8px;
    padding:28px;
    text-align:center;
  }
  .detalle-card img{
    width:100%;
    aspect-ratio:1/1;
    object-fit:cover;
    border-radius:6px;
    margin-bottom:22px;
    background:var(--leather-dark);
  }
  .detalle-card h3{
    font-family:var(--font-serif);
    font-weight:600;
    font-size:1.4rem;
    color:var(--cream);
    margin:0 0 10px;
  }
  .detalle-card .precio{
    font-family:var(--font-serif);
    font-size:1.6rem;
    color:var(--brass-bright);
    font-weight:600;
    margin:0 0 14px;
  }
  .detalle-card .descripcion{
    color:var(--cream-2);
    font-size:.92rem;
    margin:0 0 26px;
  }

  /* ---------- Contacto ---------- */
  .contacto{background:var(--cream);}
  .contacto-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
  }
  @media (max-width:760px){.contacto-grid{grid-template-columns:1fr;}}

  .info-list{list-style:none; margin:0; padding:0;}
  .info-list li{
    display:flex;
    gap:14px;
    padding:16px 0;
    border-bottom:1px solid rgba(90,58,36,.18);
  }
  .info-list li:last-child{border-bottom:none;}
  .info-list .label{
    font-family:var(--font-body);
    font-weight:700;
    font-size:.78rem;
    text-transform:uppercase;
    letter-spacing:.1em;
    color:var(--oxblood);
    min-width:110px;
  }
  .info-list .value{color:#3a2c20; font-size:.98rem;}
  .social-row{display:flex; gap:14px; margin-top:22px;}
  .social-row a{
    border:1px solid var(--oxblood);
    color:var(--oxblood);
    padding:9px 16px;
    border-radius:3px;
    text-decoration:none;
    font-size:.88rem;
    font-weight:700;
  }
  .social-row a:hover{background:var(--oxblood); color:var(--cream);}

  .map-frame{
    border-radius:6px;
    overflow:hidden;
    border:1px solid rgba(90,58,36,.25);
    min-height:320px;
  }
  .map-frame iframe{width:100%; height:100%; min-height:320px; border:0; display:block;}

  .whatsapp-cta{
    margin-top:28px;
    display:flex;
  }

  /* ---------- Footer ---------- */
  footer{
    background:var(--leather-dark);
    color:var(--cream-2);
    text-align:center;
    padding:32px 0;
    font-size:.85rem;
  }
  footer .stamp{margin:0 auto 14px; width:38px; height:38px;}
  footer .stamp span{font-size:.9rem;}
</style>
</head>
<body>

<header>
