<script>
  document.getElementById('year').textContent = new Date().getFullYear();

  const menuBtn = document.getElementById('menuBtn');
  const navLinks = document.getElementById('navLinks');
  menuBtn.addEventListener('click', () => {
    const isOpen = navLinks.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', isOpen);
  });
  navLinks.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      navLinks.classList.remove('open');
      menuBtn.setAttribute('aria-expanded', 'false');
    });
  });

  /* ============================================================
     CATÁLOGO INTERACTIVO
     Para agregar/editar productos, modificá solo este array.
     "imagen" apunta a la carpeta img/ (ver instrucciones del chat
     sobre cómo sumar fotos reales).
  ============================================================ */
  const NUMERO_WHATSAPP = '5491162059696';

  const productos = [
    { id: 1,  categoria: 'Botas', nombre: 'Bota Campo Negra', precio: '180.000', imagen: 'img/botasnegras.jpg', descripcion: 'Bota de campo en cuero vacuno, horma ancha, ideal para trabajo diario.' },
    { id: 2,  categoria: 'Botas', nombre: 'Bota Cuero Marrón', precio: '175.000', imagen: 'img/botacuero.jpg', descripcion: 'Bota de campo en cuero marrón, suela reforzada.' },

    { id: 3,  categoria: 'Mantas', nombre: 'Manta Polar Gris', precio: '45.000', imagen: 'img/placeholder.jpg', descripcion: 'Manta polar para el lomo, liviana y de secado rápido.' },
    { id: 4,  categoria: 'Mantas', nombre: 'Pellón de Lana', precio: '68.000', imagen: 'img/placeholder.jpg', descripcion: 'Pellón de lana natural, alta absorción de sudor.' },

    { id: 5,  categoria: 'Monturas', nombre: 'Montura de Cuero', precio: '320.000', imagen: 'img/monturacuero.jpg', descripcion: 'Montura criolla armada en cuero crudo, lista para trabajo de campo.' },
    { id: 6,  categoria: 'Monturas', nombre: 'Montura de Doma', precio: '410.000', imagen: 'img/monturamarron.jpg', descripcion: 'Montura de doma clásica, terminación en cuero curtido.' },

    { id: 7,  categoria: 'Accesorios de cuero', nombre: 'Cabezada de Cuero', precio: '38.000', imagen: 'img/placeholder.jpg', descripcion: 'Cabezada trenzada a mano en cuero vacuno.' },
    { id: 8,  categoria: 'Accesorios de cuero', nombre: 'Cincha de Cuero', precio: '29.000', imagen: 'img/placeholder.jpg', descripcion: 'Cincha reforzada, hebillas de bronce.' },

    { id: 9,  categoria: 'Indumentaria de campo', nombre: 'Poncho Pampa', precio: '95.000', imagen: 'img/placeholder.jpg', descripcion: 'Poncho de lana pesada, tejido tradicional.' },
    { id: 10, categoria: 'Indumentaria de campo', nombre: 'Campera de Campo', precio: '110.000', imagen: 'img/placeholder.jpg', descripcion: 'Campera resistente al agua, pensada para la intemperie.' },

    { id: 11, categoria: 'Cojinillos', nombre: 'Cojinillo de Cuero Negro', precio: '52.000', imagen: 'img/placeholder.jpg', descripcion: 'Cojinillo de cuero negro, doble costura.' },
    { id: 12, categoria: 'Cojinillos', nombre: 'Cojinillo de Lana Natural', precio: '60.000', imagen: 'img/placeholder.jpg', descripcion: 'Cojinillo de lana de oveja, muy mullido.' },

    { id: 13, categoria: 'Recados', nombre: 'Recado Completo Trabajo', precio: '480.000', imagen: 'img/placeholder.jpg', descripcion: 'Recado completo, listo para uso diario de campo.' },
    { id: 14, categoria: 'Recados', nombre: 'Recado de Gala', precio: '650.000', imagen: 'img/placeholder.jpg', descripcion: 'Recado de gala con terminaciones en plata nickelada.' },

    { id: 15, categoria: 'Bastos y coronas', nombre: 'Basto de Campo', precio: '85.000', imagen: 'img/placeholder.jpg', descripcion: 'Basto reforzado para trabajo de campo diario.' },
    { id: 16, categoria: 'Bastos y coronas', nombre: 'Corona Repujada', precio: '42.000', imagen: 'img/placeholder.jpg', descripcion: 'Corona de cuero repujado a mano.' },
  ];

  const vistaCategorias = document.getElementById('vistaCategorias');
  const vistaProductos  = document.getElementById('vistaProductos');
  const vistaDetalle    = document.getElementById('vistaDetalle');
  const gridProductos   = document.getElementById('gridProductos');
  const tituloCategoria = document.getElementById('tituloCategoria');
  const detalleCard     = document.getElementById('detalleCard');

  function mostrarVista(vista){
    [vistaCategorias, vistaProductos, vistaDetalle].forEach(v => v.classList.add('vista-oculta'));
    vista.classList.remove('vista-oculta');
  }

  function linkWhatsApp(nombreProducto){
    const mensaje = `Hola buenos días, quiero recibir más información de ${nombreProducto}`;
    return `https://wa.me/${NUMERO_WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
  }

  function abrirCategoria(nombreCategoria){
    tituloCategoria.textContent = nombreCategoria;
    const productosCategoria = productos.filter(p => p.categoria === nombreCategoria);

    gridProductos.innerHTML = productosCategoria.map(p => `
      <div class="card producto-card" data-id="${p.id}" tabindex="0" role="button">
        <img class="producto-img" src="${p.imagen}" alt="${p.nombre}">
        <div class="producto-info">
          <h3>${p.nombre}</h3>
          <p class="precio">$${p.precio}</p>
          <button class="add-cart-mini" data-id="${p.id}" type="button">+ Agregar al carrito</button>
        </div>
      </div>
    `).join('');

    gridProductos.querySelectorAll('.producto-card').forEach(card => {
      const id = Number(card.dataset.id);
      const abrir = (e) => {
        if(e.target.closest('.add-cart-mini')) return; // el botón de agregar no debe abrir el detalle
        abrirDetalle(id);
      };
      card.addEventListener('click', abrir);
      card.addEventListener('keydown', e => { if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); abrirDetalle(id); } });
    });

    gridProductos.querySelectorAll('.add-cart-mini').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = Number(btn.dataset.id);
        const producto = productos.find(p => p.id === id);
        agregarAlCarrito(producto, 1);
        btn.textContent = '✓ Agregado';
        btn.classList.add('agregado');
        setTimeout(() => { btn.textContent = '+ Agregar al carrito'; btn.classList.remove('agregado'); }, 1200);
      });
    });

    mostrarVista(vistaProductos);
  }

  function abrirDetalle(id){
    const p = productos.find(prod => prod.id === id);
    if(!p) return;

    detalleCard.innerHTML = `
      <img src="${p.imagen}" alt="${p.nombre}">
      <h3>${p.nombre}</h3>
      <p class="precio">$${p.precio}</p>
      <p class="descripcion">${p.descripcion}</p>
      <div class="detalle-botones">
        <button class="btn btn-outline" id="btnAgregarDetalle" type="button">Agregar al carrito</button>
        <a class="btn btn-primary" href="${linkWhatsApp(p.nombre)}" target="_blank" rel="noopener">Consultar</a>
      </div>
    `;

    document.getElementById('btnAgregarDetalle').addEventListener('click', (e) => {
      agregarAlCarrito(p, 1);
      const btn = e.currentTarget;
      btn.textContent = '✓ Agregado al carrito';
      setTimeout(() => { btn.textContent = 'Agregar al carrito'; }, 1200);
    });

    mostrarVista(vistaDetalle);
  }

  // Clic en una categoría de la grilla principal
  vistaCategorias.querySelectorAll('.card[data-categoria]').forEach(card => {
    const abrir = () => abrirCategoria(card.dataset.categoria);
    card.addEventListener('click', abrir);
    card.addEventListener('keydown', e => { if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); abrir(); } });
  });

  // Botones de volver
  document.getElementById('btnVolverCategorias').addEventListener('click', () => mostrarVista(vistaCategorias));
  document.getElementById('btnVolverProductos').addEventListener('click', () => mostrarVista(vistaProductos));
  document.getElementById('btnVolverCategoriasDesdeDetalle').addEventListener('click', () => mostrarVista(vistaCategorias));

  /* ============================================================
     CARRITO DE COMPRAS
     Se guarda en localStorage bajo la clave CARRITO_KEY, así que
     sobrevive a recargar la página (pero es propio de cada
     navegador/dispositivo, no se comparte entre visitantes).

     Estructura de cada item guardado:
     { id, nombre, precio (número), cantidad, imagen, nota }
  ============================================================ */
  const CARRITO_KEY = 'elmoro_carrito';
  let carrito = cargarCarrito();
  let notasAbiertas = new Set(); // ids con el campo de nota desplegado

  function cargarCarrito(){
    try{
      const guardado = localStorage.getItem(CARRITO_KEY);
      return guardado ? JSON.parse(guardado) : [];
    }catch(e){
      console.warn('No se pudo leer el carrito guardado:', e);
      return [];
    }
  }

  function guardarCarrito(){
    try{
      localStorage.setItem(CARRITO_KEY, JSON.stringify(carrito));
    }catch(e){
      console.warn('No se pudo guardar el carrito:', e);
    }
  }

  // "180.000" -> 180000
  function parsePrecio(precioStr){
    return Number(String(precioStr).replace(/\./g, ''));
  }
  // 180000 -> "180.000"
  function formatPrecio(numero){
    return Math.round(numero).toLocaleString('es-AR');
  }

  function agregarAlCarrito(producto, cantidad = 1){
    const existente = carrito.find(item => item.id === producto.id);
    if(existente){
      existente.cantidad += cantidad;
    } else {
      carrito.push({
        id: producto.id,
        nombre: producto.nombre,
        precio: parsePrecio(producto.precio),
        cantidad: cantidad,
        imagen: producto.imagen,
        nota: ''
      });
    }
    guardarCarrito();
    renderCarrito();
    bumpBadge();
  }

  function cambiarCantidad(id, delta){
    const item = carrito.find(i => i.id === id);
    if(!item) return;
    item.cantidad += delta;
    if(item.cantidad <= 0){
      eliminarDelCarrito(id);
      return;
    }
    guardarCarrito();
    renderCarrito();
  }

  function eliminarDelCarrito(id){
    const elItem = cartItems.querySelector(`.cart-item[data-id="${id}"]`);
    if(elItem){
      // animación de salida antes de sacarlo del array
      elItem.classList.add('saliendo');
      setTimeout(() => {
        carrito = carrito.filter(i => i.id !== id);
        notasAbiertas.delete(id);
        guardarCarrito();
        renderCarrito();
      }, 200);
    } else {
      carrito = carrito.filter(i => i.id !== id);
      guardarCarrito();
      renderCarrito();
    }
  }

  function actualizarNota(id, texto){
    const item = carrito.find(i => i.id === id);
    if(item){
      item.nota = texto;
      guardarCarrito();
      // no re-renderizamos acá para no perder el foco mientras se escribe
    }
  }

  function vaciarCarrito(){
    if(carrito.length === 0) return;
    if(!confirm('¿Vaciar todo el carrito?')) return;
    carrito = [];
    notasAbiertas.clear();
    guardarCarrito();
    renderCarrito();
  }

  function calcularTotal(){
    return carrito.reduce((acc, item) => acc + item.precio * item.cantidad, 0);
  }

  function calcularCantidadTotal(){
    return carrito.reduce((acc, item) => acc + item.cantidad, 0);
  }

  function bumpBadge(){
    cartBadge.classList.remove('bump');
    void cartBadge.offsetWidth; // fuerza reflow para poder repetir la animación
    cartBadge.classList.add('bump');
  }

  function generarMensajeWhatsApp(){
    const lineas = carrito.map(item => {
      const subtotal = item.precio * item.cantidad;
      const cantidadTexto = item.cantidad > 1 ? ` × ${item.cantidad}` : '';
      const notaTexto = item.nota ? ` (${item.nota})` : '';
      return `• ${item.nombre}${cantidadTexto}${notaTexto} → $${formatPrecio(subtotal)}`;
    });
    const total = calcularTotal();
    return `Hola buenos días, estoy interesado en realizar una compra de los siguientes productos:\n\n${lineas.join('\n')}\n\nTotal: $${formatPrecio(total)}\n\n¿Podemos coordinar el medio de pago y envío? \nGracias!`;
  }

  function renderCarrito(){
    // Badge del header
    const cantidadTotal = calcularCantidadTotal();
    cartBadge.textContent = cantidadTotal;
    cartBadge.hidden = cantidadTotal === 0;

    // Lista de items
    if(carrito.length === 0){
      cartItems.innerHTML = '<p class="cart-empty">Tu carrito está vacío.</p>';
    } else {
      cartItems.innerHTML = carrito.map(item => `
        <div class="cart-item" data-id="${item.id}">
          <img class="cart-item-img" src="${item.imagen}" alt="${item.nombre}">
          <div class="cart-item-body">
            <div class="cart-item-top">
              <h4>${item.nombre}</h4>
              <button class="cart-item-remove" data-action="eliminar" aria-label="Eliminar producto" type="button">🗑</button>
            </div>
            <p class="cart-item-price">$${formatPrecio(item.precio)} c/u</p>
            <div class="cart-item-controls">
              <div class="qty-control">
                <button data-action="dec" aria-label="Restar cantidad" type="button">−</button>
                <span>${item.cantidad}</span>
                <button data-action="inc" aria-label="Sumar cantidad" type="button">+</button>
              </div>
              <button class="cart-item-edit" data-action="editar" type="button">Editar</button>
            </div>
            <div class="cart-item-note ${notasAbiertas.has(item.id) ? 'abierta' : ''}">
              <input type="text" data-action="nota" placeholder="Nota (ej: talle 42)" value="${(item.nota || '').replace(/"/g, '&quot;')}">
            </div>
            <p class="cart-item-subtotal">Subtotal: $${formatPrecio(item.precio * item.cantidad)}</p>
          </div>
        </div>
      `).join('');
    }

    // Total y link de WhatsApp
    cartTotal.textContent = `$${formatPrecio(calcularTotal())}`;
    cartCheckoutBtn.href = carrito.length
      ? `https://wa.me/${NUMERO_WHATSAPP}?text=${encodeURIComponent(generarMensajeWhatsApp())}`
      : '#';
    cartCheckoutBtn.classList.toggle('disabled', carrito.length === 0);
  }

  function abrirCarrito(){
    cartPanel.classList.add('abierto');
    cartOverlay.classList.add('abierto');
    document.body.classList.add('carrito-abierto');
  }
  function cerrarCarrito(){
    cartPanel.classList.remove('abierto');
    cartOverlay.classList.remove('abierto');
    document.body.classList.remove('carrito-abierto');
  }

  // Referencias DOM del carrito
  const cartBtn = document.getElementById('cartBtn');
  const cartBadge = document.getElementById('cartBadge');
  const cartPanel = document.getElementById('cartPanel');
  const cartOverlay = document.getElementById('cartOverlay');
  const cartCloseBtn = document.getElementById('cartCloseBtn');
  const cartItems = document.getElementById('cartItems');
  const cartTotal = document.getElementById('cartTotal');
  const cartCheckoutBtn = document.getElementById('cartCheckoutBtn');
  const cartClearBtn = document.getElementById('cartClearBtn');

  cartBtn.addEventListener('click', abrirCarrito);
  cartCloseBtn.addEventListener('click', cerrarCarrito);
  cartOverlay.addEventListener('click', cerrarCarrito);
  cartClearBtn.addEventListener('click', vaciarCarrito);
  cartCheckoutBtn.addEventListener('click', (e) => {
    if(carrito.length === 0) e.preventDefault();
  });

  // Delegación de eventos: +/-, eliminar y editar dentro del panel
  cartItems.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-action]');
    if(!btn) return;
    const itemEl = e.target.closest('.cart-item');
    const id = Number(itemEl.dataset.id);
    const accion = btn.dataset.action;

    if(accion === 'inc') cambiarCantidad(id, 1);
    if(accion === 'dec') cambiarCantidad(id, -1);
    if(accion === 'eliminar') eliminarDelCarrito(id);
    if(accion === 'editar'){
      if(notasAbiertas.has(id)) notasAbiertas.delete(id);
      else notasAbiertas.add(id);
      renderCarrito();
    }
  });

  // Guardar la nota mientras se escribe, sin perder el foco del input
  cartItems.addEventListener('input', (e) => {
    if(e.target.dataset.action === 'nota'){
      const itemEl = e.target.closest('.cart-item');
      const id = Number(itemEl.dataset.id);
      actualizarNota(id, e.target.value);
    }
  });

  // Cerrar el carrito con la tecla Escape
  document.addEventListener('keydown', (e) => {
    if(e.key === 'Escape') cerrarCarrito();
  });

  renderCarrito();
</script>

</body>
</html>
